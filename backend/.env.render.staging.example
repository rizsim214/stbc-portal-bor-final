APP_NAME=STBC
APP_ENV=staging
APP_KEY=base64:replace-with-your-shared-render-app-key
APP_DEBUG=false
APP_URL=https://stbc-api-staging.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
AUTH_GUARD=sanctum

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL=admin-staging@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

DB_CONNECTION=pgsql
DB_URL=postgresql://stbc_user:replace-with-render-postgres-password@replace-with-render-postgres-host:5432/stbc_staging
DB_HOST=replace-with-render-postgres-host
DB_PORT=5432
DB_DATABASE=stbc_staging
DB_USERNAME=stbc_user
DB_PASSWORD=replace-with-render-postgres-password
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=stbc-frontend-staging.onrender.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_WORKER_SLEEP=1
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_MEMORY=256
QUEUE_WORKER_MAX_JOBS=1000
QUEUE_WORKER_MAX_TIME=3600

REVERB_APP_ID=stbc-staging
REVERB_APP_KEY=replace-with-staging-reverb-key
REVERB_APP_SECRET=replace-with-staging-reverb-secret
REVERB_HOST=stbc-reverb-staging.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://stbc-frontend-staging.onrender.com

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_URL=redis://default:replace-with-render-redis-password@replace-with-render-redis-host:6379
REDIS_HOST=replace-with-render-redis-host
REDIS_PASSWORD=replace-with-render-redis-password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=helpdesk-staging@stbc.com
MAIL_FROM_NAME="${APP_NAME}"

SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-staging-supabase-access-key
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-staging-supabase-secret-key
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=lab-results-staging
SUPABASE_STORAGE_ENDPOINT=https://replace-with-staging-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_PATH_STYLE=true

LAB_RESULTS_STORAGE_DISK=supabase
LAB_RESULTS_UPLOAD_URL_TTL_MINUTES=10
LAB_RESULTS_DOWNLOAD_URL_TTL_MINUTES=5
LAB_RESULTS_MAX_FILE_SIZE_BYTES=10485760

SANCTUM_STATEFUL_DOMAINS=stbc-frontend-staging.onrender.com
SANCTUM_ROUTES=false
CORS_ALLOWED_ORIGINS=https://stbc-frontend-staging.onrender.com

VITE_APP_NAME="${APP_NAME}"
