APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_GUARD=sanctum

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

INITIAL_ADMIN_NAME="System Admin"
INITIAL_ADMIN_EMAIL=admin@stbc.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stbc
DB_USERNAME=stbc_user
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@stbc.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lab-results
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional public/custom URL for S3 objects (usually leave blank for private buckets).
# AWS_URL=

# Lab result upload/download signed URL settings.
# Keep LAB_RESULTS_STORAGE_DISK=s3 when using S3-compatible storage.
LAB_RESULTS_STORAGE_DISK=s3
LAB_RESULTS_UPLOAD_URL_TTL_MINUTES=10
LAB_RESULTS_DOWNLOAD_URL_TTL_MINUTES=5
LAB_RESULTS_MAX_FILE_SIZE_BYTES=10485760
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_ROUTES=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
