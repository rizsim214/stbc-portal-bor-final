APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_GUARD=sanctum

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL=admin@stbc.local
INITIAL_ADMIN_PASSWORD=password123

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stbc
DB_USERNAME=stbc_user
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
QUEUE_WORKER_SLEEP=1
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_MEMORY=256
QUEUE_WORKER_MAX_JOBS=1000
QUEUE_WORKER_MAX_TIME=3600
REVERB_APP_ID=stbc-app
REVERB_APP_KEY=stbc-reverb-key
REVERB_APP_SECRET=stbc-reverb-secret
# Laravel publishes broadcasts to the Reverb server from inside the PHP runtime.
# In Docker, the app and queue worker should publish to the dedicated "reverb" service.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb should listen on all container interfaces so Docker can publish the port.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browser websocket clients do not use the values above. Point the frontend env to
# the host-mapped port instead, for example:
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
# Browser origins allowed to open websocket connections.
REVERB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@stbc.com"
MAIL_FROM_NAME="${APP_NAME}"

#
# Object storage credentials.
# Local Docker MinIO defaults are set below.
# For staging/production, replace these with the environment-specific object storage credentials.
#
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lab-results
#
# IMPORTANT:
# This application signs upload/download URLs and the browser uses those URLs directly.
# Because of that, AWS_ENDPOINT must be reachable by the browser, not just the PHP container.
#
# Local development:
# - Keep MinIO running on the mapped host port.
# - Use localhost:9000 so signed URLs work from the browser.
#
# Staging/Production:
# - Use your public or internal browser-reachable S3-compatible endpoint.
# - Examples:
#   AWS_ENDPOINT=https://minio-staging.example.com
#   AWS_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
#
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional custom object URL base. Usually leave blank for private buckets that use signed URLs.
# For staging/production, only set this if your object-storage provider specifically requires it.
# AWS_URL=

# Lab result upload/download signed URL settings.
# Keep LAB_RESULTS_STORAGE_DISK=s3 when using MinIO, AWS S3, or another S3-compatible provider.
# For staging/production, update the TTL values here if your security or UX policy differs.
LAB_RESULTS_STORAGE_DISK=s3
LAB_RESULTS_UPLOAD_URL_TTL_MINUTES=10
LAB_RESULTS_DOWNLOAD_URL_TTL_MINUTES=5
LAB_RESULTS_MAX_FILE_SIZE_BYTES=10485760
#
# Frontend origin allowed to call the backend API.
# For staging/production, replace these with the deployed frontend origins.
# Example:
# CORS_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
#
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_ROUTES=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
