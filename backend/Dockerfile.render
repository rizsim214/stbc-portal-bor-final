FROM composer:2 AS vendor

WORKDIR /app

RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git unzip; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends git unzip \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*; \
    else \
        echo "No supported package manager found for vendor stage." >&2; \
        exit 1; \
    fi

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-interaction \
    --prefer-install=auto \
    --optimize-autoloader \
    || composer install \
    --no-dev \
    --no-scripts \
    --no-interaction \
    --prefer-source \
    --optimize-autoloader

COPY . .
RUN mkdir -p resources/views \
    && composer dump-autoload --optimize --classmap-authoritative \
    && php artisan package:discover --ansi


FROM php:8.3-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    gettext-base \
    git \
    unzip \
    libpq-dev \
    libzip-dev \
    && docker-php-ext-install pdo_pgsql pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/render/project/src

COPY --from=vendor /app /opt/render/project/src
COPY docker/render/nginx.conf.template /etc/nginx/templates/render.conf.template
COPY docker/render/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN mkdir -p storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    resources/views \
    bootstrap/cache \
    /var/log/supervisor \
    /run/php \
    && chmod +x scripts/render-start.sh \
    && chown -R www-data:www-data /opt/render/project/src \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 10000

CMD ["sh", "scripts/render-start.sh"]
